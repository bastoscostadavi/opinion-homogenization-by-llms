\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Asymptotic consensus value $x^*$ as a function of $\alpha /\beta $ for the adaptive UA (B2-DeGroot). Solid curves are simulation results for several $(\alpha ,\beta )$ pairs; dashed lines show the analytical prediction \eqref  {eq:xstar}. The formula is confirmed to machine precision. For $\alpha /\beta \gg 1$, $x^*\approx x_{\mathrm  {UA}}(0)=0.8$; for $\alpha /\beta \ll 1$, $x^*\approx \bar  {x}(0)\approx 0.5$.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:adaptive}{{3}{12}{Asymptotic consensus value $x^*$ as a function of $\alpha /\beta $ for the adaptive UA (B2-DeGroot). Solid curves are simulation results for several $(\alpha ,\beta )$ pairs; dashed lines show the analytical prediction \eqref {eq:xstar}. The formula is confirmed to machine precision. For $\alpha /\beta \gg 1$, $x^*\approx \xUA (0)=0.8$; for $\alpha /\beta \ll 1$, $x^*\approx \xbar (0)\approx 0.5$}{figure.3}{}}
