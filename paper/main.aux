\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Asymptotic opinion variance $\mathrm  {Var}(\infty )$ as a function of UA coupling strength~$\alpha $ for three values of the confidence bound $\varepsilon \in \{0.1, 0.2, 0.3\}$. Each curve is the mean over 20 independent seeds; shaded bands show $\pm 1$ standard deviation. A sharp drop (phase transition) is visible at $\alpha ^*\approx 0.01$--$0.04$ for $\varepsilon =0.1$ and $0.2$. For $\varepsilon =0.3$ the system achieves consensus even without the UA.}}{10}{figure.1}\protected@file@percent }
\newlabel{fig:variance_alpha}{{1}{10}{Asymptotic opinion variance $\Var (\infty )$ as a function of UA coupling strength~$\alpha $ for three values of the confidence bound $\varepsilon \in \{0.1, 0.2, 0.3\}$. Each curve is the mean over 20 independent seeds; shaded bands show $\pm 1$ standard deviation. A sharp drop (phase transition) is visible at $\alpha ^*\approx 0.01$--$0.04$ for $\varepsilon =0.1$ and $0.2$. For $\varepsilon =0.3$ the system achieves consensus even without the UA}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Topology Invariance (Experiment 1, extended)}{10}{subsection.5.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Heatmap of asymptotic opinion variance in the $(\alpha ,\varepsilon )$ plane. Dark (low variance) regions correspond to UA-induced consensus; bright (high variance) regions to multi-cluster fragmentation. The boundary traces the critical curve $\alpha ^*(\varepsilon )$ predicted by \eqref  {eq:alphastar}.}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:heatmap}{{2}{11}{Heatmap of asymptotic opinion variance in the $(\alpha ,\varepsilon )$ plane. Dark (low variance) regions correspond to UA-induced consensus; bright (high variance) regions to multi-cluster fragmentation. The boundary traces the critical curve $\alpha ^*(\varepsilon )$ predicted by \eqref {eq:alphastar}}{figure.2}{}}
