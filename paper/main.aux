\newlabel{sec:simulations}{{5}{5}{}{section.5}{}}
\newlabel{fig:R1}{{1}{6}{\textbf {R1.} Final consensus value $x^*$ as a function of the UA learning rate $\beta $ (log scale) at fixed $\alpha =0.3$, $\varepsilon =0.1$, $\xUA (0)=0.8$. Orange squares: simulation. Dashed black: theory from Theorem~\ref {thm:R1}. Horizontal dotted lines: limiting values $\xUA (0)$ ($\beta \to 0$) and $\xbar (0)$ ($\beta \to 1$). The simulation uses HK with $\varepsilon =0.1$; at $\alpha =0.3\gg \alpha ^*$ the system collapses to a single cluster and the DeGroot fixed-point formula applies}{figure.1}{}}
\newlabel{fig:R2_variance}{{2}{6}{\textbf {R2.} Normalized asymptotic variance vs.\ coupling $\alpha $ for HK with a fixed UA ($\beta =0$), $\xUA =0.8$, $N=100$. A sharp drop occurs at $\hat \alpha ^*\approx 0.001$--$0.003$ for $\varepsilon \in \{0.1,0.15,0.2\}$; dashed lines mark the empirical $\hat \alpha ^*$ per curve}{figure.2}{}}
\newlabel{fig:R2_heatmap}{{3}{6}{\textbf {R2.} Heat map of the asymptotic cluster count $K(\infty )$ in the $(\alpha ,\varepsilon )$ plane (log~$\alpha $). Dark = consensus; bright = fragmented. The boundary traces the empirical critical coupling $\hat \alpha ^*(\varepsilon )$}{figure.3}{}}
\newlabel{fig:R3_fixed}{{4}{7}{\textbf {R3 (A).} Four fixed UAs at $u_j\in \{0.20,0.40,0.60,0.80\}$ produce permanent $K=4$ clusters anchored at the UA positions ($N=100$, $\varepsilon =0.1$, $\alpha =0.3$)}{figure.4}{}}
\newlabel{sec:discussion}{{6}{7}{}{section.6}{}}
\newlabel{fig:R3_adapt}{{5}{7}{\textbf {R3 (B).} Cluster count $K(t)$ for $k=4$ adaptive UAs at $\beta =0.01$. Global adaptation (solid red) collapses $K\colon 4\to 1$ by $t\approx 160$; local adaptation (dashed blue) preserves $K=4$ indefinitely, in agreement with Theorem~\ref {thm:R3}(b)}{figure.5}{}}
