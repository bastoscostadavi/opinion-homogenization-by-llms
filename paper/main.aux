\newlabel{fig:R4}{{6}{8}{\textbf {R4 (A).} Cascade trajectories under bimodal $P(\alpha )$ ($50\%$ at $\alpha _i=0.60$, $50\%$ at $\alpha _i=0$; $N=50$, $\varepsilon =0.1$, $\xUA =0.8$). High-$\alpha $ agents converge within $t\approx 3$; low-$\alpha $ agents persist in peer clusters}{figure.6}{}}
\newlabel{sec:conclusion}{{7}{8}{}{section.7}{}}
\newlabel{fig:R4_bar}{{7}{8}{\textbf {R4 (B).} Final cluster count $K(\infty )$ under four reliance distributions ($N=100$, $\varepsilon =0.1$, $\xUA =0.8$): no UA, bimodal $0\%/30\%$, bimodal $0\%/60\%$, and a heavy-tail $\mathrm {Beta}(0.5,2)$. The heavy tail collapses to $K=1$ despite a lower mean $\bar \alpha $ than either bimodal case}{figure.7}{}}
