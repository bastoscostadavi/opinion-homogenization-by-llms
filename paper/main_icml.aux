\newlabel{sec:simulations}{{5}{6}{}{section.5}{}}
\newlabel{fig:variance_alpha}{{1}{6}{Asymptotic opinion variance $\Var (\infty )$ as a function of UA coupling strength~$\alpha $ for three values of the confidence bound $\varepsilon \in \{0.1, 0.2, 0.3\}$. Each curve is the mean over 20 independent seeds; shaded bands show $\pm 1$ standard deviation. A sharp drop (phase transition) is visible at $\alpha ^*\approx 0.01$--$0.04$ for $\varepsilon =0.1$ and $0.2$. For $\varepsilon =0.3$ the system achieves consensus even without the UA}{figure.1}{}}
\newlabel{fig:heatmap}{{2}{7}{Heatmap of asymptotic opinion variance in the $(\alpha ,\varepsilon )$ plane. Dark (low variance) regions correspond to UA-induced consensus; bright (high variance) regions to multi-cluster fragmentation. The boundary traces the critical curve $\alpha ^*(\varepsilon )$ predicted by \eqref {eq:alphastar}}{figure.2}{}}
\newlabel{sec:discussion}{{6}{7}{}{section.6}{}}
\newlabel{fig:adaptive}{{3}{7}{Asymptotic consensus value $x^*$ as a function of $\alpha /\beta $ for the adaptive UA (B2-DeGroot). Solid curves are simulation results for several $(\alpha ,\beta )$ pairs; dashed lines show the analytical prediction \eqref {eq:xstar}. The formula is confirmed to machine precision. For $\alpha /\beta \gg 1$, $x^*\approx \xUA (0)=0.8$; for $\alpha /\beta \ll 1$, $x^*\approx \xbar (0)\approx 0.5$}{figure.3}{}}
\newlabel{fig:heterogeneous}{{4}{7}{Opinion distributions at stationarity under uniform (left) and bimodal (right) coupling. The bimodal $P(\alpha )$ produces three distinct clusters with stratification index $\mathcal {S}\approx 0.27$, while the uniform distribution collapses to $K=1$. Dashed vertical lines mark cluster centroids; the UA position $\xUA =0.8$ is indicated by the red arrow}{figure.4}{}}
\newlabel{sec:conclusion}{{7}{8}{}{section.7}{}}
